{
  "name": "personas",
  "displayName": "Personas",
  "description": "See and manage your developer personas in one sidebar: VS Code profiles and their extensions, PowerShell profiles, and the Git identity in effect.",
  "version": "1.7.0",
  "publisher": "SamErde",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "profiles",
    "vscode profiles",
    "profile manager",
    "extensions",
    "extension manager",
    "persona",
    "identity",
    "git",
    "git config",
    "git identity",
    "includeIf",
    "powershell",
    "powershell profile",
    "workspace",
    "orphaned extensions",
    "cleanup"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "media/icon-256.png",
  "galleryBanner": {
    "color": "#16213E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SamErde/Personas"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "personas.openSettings",
        "title": "Open Personas Settings",
        "category": "Personas",
        "icon": "$(settings-gear)"
      },
      {
        "command": "personas.showMatrix",
        "title": "Open Extension Matrix",
        "category": "Personas",
        "icon": "$(extensions)"
      },
      {
        "command": "personas.powerShellProfiles.refresh",
        "title": "Refresh PowerShell Profiles",
        "category": "Personas",
        "icon": "$(refresh)"
      },
      {
        "command": "personas.powerShellProfiles.help",
        "title": "PowerShell Profiles Help",
        "category": "Personas",
        "icon": "$(question)"
      },
      {
        "command": "personas.gitConfiguration.refresh",
        "title": "Refresh Git Configuration",
        "category": "Personas",
        "icon": "$(refresh)"
      },
      {
        "command": "personas.gitConfiguration.showEffective",
        "title": "Show Effective Git Configuration",
        "category": "Personas",
        "icon": "$(list-flat)"
      },
      {
        "command": "personas.gitConfiguration.openFile",
        "title": "Open Git Config File",
        "category": "Personas",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "personas.openSettings",
          "when": "view == personas.vscodeProfiles || view == personas.powerShellProfiles || view == personas.gitConfiguration",
          "group": "navigation@9"
        },
        {
          "command": "personas.powerShellProfiles.refresh",
          "when": "view == personas.powerShellProfiles",
          "group": "navigation@1"
        },
        {
          "command": "personas.powerShellProfiles.help",
          "when": "view == personas.powerShellProfiles",
          "group": "navigation@2"
        },
        {
          "command": "personas.gitConfiguration.showEffective",
          "when": "view == personas.gitConfiguration",
          "group": "navigation@1"
        },
        {
          "command": "personas.gitConfiguration.refresh",
          "when": "view == personas.gitConfiguration",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "personas.gitConfiguration.openFile",
          "when": "view == personas.gitConfiguration && viewItem == personas.gitConfigFile",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "personas.gitConfiguration.openFile",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personas",
          "title": "Personas",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "personas": [
        {
          "id": "personas.vscodeProfiles",
          "name": "VS Code Profiles",
          "type": "webview",
          "initialSize": 5,
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Personas"
        },
        {
          "id": "personas.powerShellProfiles",
          "name": "PowerShell Profiles",
          "type": "webview",
          "initialSize": 3,
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Personas"
        },
        {
          "id": "personas.gitConfiguration",
          "name": "Git Configuration",
          "initialSize": 2,
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Personas"
        }
      ]
    },
    "configuration": {
      "title": "Personas",
      "properties": {
        "personas.experimentalFeatures.enabled": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "markdownDescription": "Enable experimental Personas actions. Experimental actions are labeled, require confirmation, and can rely on undocumented VS Code behavior that may change between releases. Disable this to keep only supported and guided actions."
        },
        "personas.powerShellProfiles.allowRuntimeDiscovery": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Allow detected PowerShell executables to report their canonical profile paths in the background. Profiles are disabled during each probe. Turn this off to use only passive discovery and the Windows registry fallback."
        },
        "personas.powerShellProfiles.includeWindowsPowerShell": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Include Windows PowerShell 5.1 installations and their profiles, including ISE profiles, in discovery and editing on Windows."
        },
        "personas.extensionMatrix.openWithSidebar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, showing the VS Code Profiles view in the Personas sidebar also opens the Extension Matrix — including on window restore if the view was left showing. Disable to require clicking the \"Open Extension Matrix\" button instead. Collapsing the VS Code Profiles view also stops it, but only while another Personas view is shown too: VS Code expands a view that is the only one left in the sidebar. Use this setting for an opt-out that lasts."
        },
        "personas.openMatrixOnActivityBarClick": {
          "type": "boolean",
          "default": true,
          "markdownDeprecationMessage": "Renamed to `#personas.extensionMatrix.openWithSidebar#`. A value set here is still honored when the new setting is not set."
        },
        "personas.showAgentsWindowProfile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show VS Code's built-in Agents window profile in the Extension Matrix and the Personas sidebar. It uses the Default profile's extensions, so its column always matches Default."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "clean": "node scripts/clean.mjs",
    "vscode:prepublish": "npm run build",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && npm run test:integration:prebuilt",
    "test:integration:prebuilt": "tsc -p tsconfig.integration.json && node out-test/test/integration/runTests.js",
    "test:runtime-paths": "node scripts/verify-vscode-platform.mjs",
    "package": "node -e \"require('fs').mkdirSync('releases',{recursive:true})\" && vsce package --out releases/"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "koffi": "3.3.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "koffi@3.3.8": false,
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.1": true
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
